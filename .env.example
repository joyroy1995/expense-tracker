# ── API Keys (required) ──
# Get a Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── VAPID Keys for Web Push Notifications ──
# Generate with: python -c "from pywebpush import generate_vapid_keys; import json; print(json.dumps(generate_vapid_keys(), indent=2))"
VAPID_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
your_public_key_here
-----END PUBLIC KEY-----
VAPID_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
your_private_key_here
-----END PRIVATE KEY-----
VAPID_CLAIM_EMAIL=mailto:admin@expenses.app
VAPID_APPLICATION_SERVER_KEY=your_application_server_key_here

# ── Optional ──
# Gemini API key (fallback for receipt scanning)
GEMINI_API_KEY=

# Database (defaults to SQLite local, set for Neon/PostgreSQL in production)
DATABASE_URL=

# Secret key for Flask sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-secret-key

# Cron secret for protecting cron endpoints
CRON_SECRET=
